{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masg:schema:core-glossary:1.0.0",
  "title": "MASG Core Concept Glossary",
  "type": "object",
  "required": [
    "glossary_version",
    "source_locale",
    "glossary_scope",
    "concepts"
  ],
  "properties": {
    "glossary_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "glossary_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "term",
          "definition",
          "domain",
          "security_critical"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$",
            "maxLength": 256
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "security_critical": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
