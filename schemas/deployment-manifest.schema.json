{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MASG Deployment Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "deployment_id",
    "profile",
    "implementation",
    "contracts",
    "created_at"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "embedded",
        "isolated",
        "hardware_assured"
      ]
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MSC-[0-9]{3}$"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_TESTED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$id": "urn:masg:schema:deployment-manifest:1.0.0"
}
