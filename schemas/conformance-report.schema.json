{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masg:schema:conformance-report:1.0.0",
  "title": "MASG Conformance Report",
  "type": "object",
  "required": [
    "report_version",
    "implementation_id",
    "implementation_version",
    "protocol_version",
    "profile",
    "tested_at",
    "conformance_scope",
    "overall_status",
    "results",
    "limitations",
    "notices"
  ],
  "properties": {
    "report_version": {
      "const": "1.0.0"
    },
    "implementation_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile": {
      "enum": [
        "embedded",
        "isolated",
        "hardware_assured"
      ]
    },
    "tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_TESTED"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_TESTED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "maxLength": 2048
          },
          "notes": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessor": {
      "type": "string",
      "maxLength": 256
    },
    "source_revision": {
      "type": "string",
      "maxLength": 128
    },
    "conformance_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
