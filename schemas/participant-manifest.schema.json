{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masg:schema:participant-manifest:0.1.0",
  "title": "UEFP Participant Manifest",
  "description": "Experimental self-description format. Validation does not authenticate identity or prove declared capabilities.",
  "type": "object",
  "required": ["schema_version", "participant_id", "participant_type", "protocol_versions", "consent"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "participant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "participant_type": {
      "enum": ["HUMAN", "SOFTWARE", "AI_AGENT", "ORGANIZATION"]
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
      "uniqueItems": true
    },
    "locales": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
      "uniqueItems": true
    },
    "message_formats": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["capability_id", "description", "status"],
        "properties": {
          "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$", "maxLength": 256 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "enum": ["DECLARED", "EXPERIMENTAL", "UNAVAILABLE"] },
          "evidence_ref": { "type": "string", "maxLength": 2048 }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "consent": {
      "type": "object",
      "required": ["default_data_sharing"],
      "properties": {
        "default_data_sharing": { "enum": ["NONE", "PUBLIC_ONLY", "ASK_EACH_TIME"] },
        "requires_explicit_exchange_acceptance": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "format": "uri", "maxLength": 2048 }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "additionalProperties": false
}