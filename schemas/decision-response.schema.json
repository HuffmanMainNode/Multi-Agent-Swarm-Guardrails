{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masg:schema:decision-response:1.0.0",
  "title": "MASG Language-Neutral Authorization Decision Response",
  "type": "object",
  "required": [
    "protocol_version",
    "message_type",
    "request_id",
    "decision",
    "reason_code",
    "evaluated_at",
    "policy_version"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "message_type": {
      "const": "authorization_response"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REVIEW_REQUIRED"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,96}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "obligations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "additionalProperties": false
}
